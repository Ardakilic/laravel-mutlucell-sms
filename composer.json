{
  "name": "ardakilic/mutlucell",
  "description": "Mutlucell SMS API wrapper for sending sms text messages for Laravel",
  "keywords": [
    "laravel",
    "sms",
    "api",
    "mutlucell"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Arda Kilicdagi",
      "email": "arda@kilicdagi.com",
      "homepage": "https://arda.pw",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "13.*",
    "guzzlehttp/guzzle": "^7.8.2|^8.0.2",
    "ext-simplexml": "*"
  },
  "autoload": {
    "psr-4": {
      "Ardakilic\\Mutlucell\\": "src/Ardakilic/Mutlucell/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ardakilic\\Mutlucell\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "orchestra/testbench": "^11.0"
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "test:coverage": "phpunit --coverage-text --only-summary-for-coverage-text --coverage-clover=coverage/clover.xml"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Ardakilic\\Mutlucell\\MutlucellServiceProvider"
      ],
      "aliases": {
        "Mutlucell": "Ardakilic\\Mutlucell\\Facades\\Mutlucell"
      }
    }
  },
  "minimum-stability": "stable"
}
